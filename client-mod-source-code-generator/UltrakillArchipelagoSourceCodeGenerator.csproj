<Project Sdk="Microsoft.NET.Sdk">
	<!-- <https://andrewlock.net/series/creating-a-source-generator/> -->
	<!-- <https://www.thinktecture.com/net/roslyn-source-generators-introduction/> -->

	<PropertyGroup>
		<OutputItemType>Analyzer</OutputItemType>
		<TargetFramework>netstandard2.0</TargetFramework>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IncludeBuildOutput>false</IncludeBuildOutput>

		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

		<RootNamespace>UltrakillArchipelago.SourceCodeGenerator</RootNamespace>
		<NoWarn>IDE0003;IDE0350;IDE1006</NoWarn>
		<!--
			IDE0003: Remove explicit `this`
			IDE0350: Remove explicit parameter types in lambda/anonymous function expressions
			IDE1006: Add prefix "I" to interface names
		-->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference
			Include="Microsoft.CodeAnalysis.Analyzers"
			Version="3.11.0"
			IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive"
			PrivateAssets="all" />

		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
	</ItemGroup>
</Project>
